story.append(Paragraph("Secret Pharmacy - WordPress Exploitation", styles['Heading3']))\
story.append(Spacer(1, 0.3*inch))\
story.append(Paragraph(f"Author: Omar Al Sheikh Khalil<br/>Date: {datetime.now().strftime('%B %d, %Y')}", body_style))\
story.append(Spacer(1, 0.3*inch))\
\
