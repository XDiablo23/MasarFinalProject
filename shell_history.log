    parent=styles['Heading2'],\
    fontSize=14,\
    textColor=colors.HexColor('#2563eb'),\
    spaceAfter=12,\
    spaceBefore=12\
)\
\
body_style = ParagraphStyle(\
    'CustomBody',\
    parent=styles['BodyText'],\
    fontSize=10,\
    leading=14\
)\
