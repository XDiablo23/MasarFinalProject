python3 - <<'EOF'\
import pefile\
pe = pefile.PE("malware.exe")\
# Check delay imports\
print("=== DELAY IMPORTS ===")\
if hasattr(pe, 'DIRECTORY_ENTRY_DELAY_IMPORT'):\
    for entry in pe.DIRECTORY_ENTRY_DELAY_IMPORT:\
        print(f"\n  DLL: {entry.dll.decode(errors='replace')}")\
        for imp in entry.imports:\
            if imp.name:\
                print(f"    - {imp.name.decode(errors='replace')}")\
else:\
    print("  None found")\
# Check bound imports\
print("\n=== BOUND IMPORTS ===")\
if hasattr(pe, 'DIRECTORY_ENTRY_BOUND_IMPORT'):\
    for entry in pe.DIRECTORY_ENTRY_BOUND_IMPORT:\
        print(f"  {entry.name.decode(errors='replace')}")\
else:\
    print("  None found")\
# Print all PE directory entries\
print("\n=== ALL DIRECTORY ENTRIES ===")\
for entry in pe.OPTIONAL_HEADER.DATA_DIRECTORY:\
    if entry.Size > 0:\
        print(f"  {entry.name}: VirtualAddress={entry.VirtualAddress:#010x}, Size={entry.Size}")\
EOF
